# GEMINI_API_KEY: Optional if using cloud Google Gemini model
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# AI Provider: 'auto' | 'gemini' | 'local' | 'mock'
AI_PROVIDER="auto"

# AI Model: e.g. 'gemini-2.5-flash', 'qwen-2.5-7b', 'llama-3.2-3b', 'phi-3.5', 'gemma-2'
AI_MODEL="gemini-2.5-flash"

# AI API Key (for external providers like OpenRouter, Together, or Gemini)
AI_API_KEY=""

# PostgreSQL Database URL
DATABASE_URL="postgresql://focusmate_user:focusmate_pass@localhost:5432/focusmate"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

